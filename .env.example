# Local-only application. Never put MODEL_API_KEY in a VITE_ variable.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5173
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite:///./data/app.sqlite3
STORAGE_ROOT=./data
STORAGE_MAX_FILE_BYTES=20971520
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=5
WORKER_POLL_SECONDS=2
MODEL_PROVIDER=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
